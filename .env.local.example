# --- Stripe (educational SoliVana account) ---
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_FOUNDATION_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Make.com webhook for purchase fan-out ---
MAKE_WEBHOOK_URL=https://hook.us2.make.com/...

# --- App ---
NEXT_PUBLIC_BASE_URL=https://foundation.solivana.ai

# --- Library (member portal) ---
# Shared password (fallback). Magic-link via email is the primary path now.
LIBRARY_PASSWORD=change-me-long-random-string
# HMAC signing secret for session cookies AND magic-link tokens.
# Generate with: openssl rand -hex 32
LIBRARY_SESSION_SECRET=change-me-to-a-random-hex-string

# --- GHL (LeadConnector v2) ---
# Used by /api/library/login-magic to look up contact + check
# foundation-active-cohort tag before sending magic link.
# Find at GHL → Settings → Business Profile → API Key (location-scoped).
GHL_API_KEY=
GHL_LOCATION_ID=
# Full URL for the office-hours booking widget at /library/office-hours.
GHL_CALENDAR_URL=

# --- Resend (contact form + magic link) ---
# Sends from the app's verified Resend sender — canonical:
# notifications@foundation.solivana.ai. Replies set to user (magic) or
# info@solivana.com (contact form).
RESEND_API_KEY=re_...

# --- Anthropic (AI Companion) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Foundation free-redemption codes ---
# Comma-separated list of codes that grant free Foundation access via the
# /redeem page. Recipient enters one + their name + email; we create a GHL
# contact, tag them foundation-active-cohort + foundation-tier-comp, and
# email a magic-link sign-in. Rotate values without code changes.
# Examples: NATASHACOMP, VIPACCESS, LAUNCHCOMP
FOUNDATION_FREE_CODES=

# --- Experiments / A/B testing ---
# A | B | both
# 'both' randomizes per visitor (50/50 cookie). A or B locks all visitors.
EXPERIMENT_HERO_VARIANT=A
